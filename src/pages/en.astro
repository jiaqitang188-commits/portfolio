---
import Layout from '../layouts/Layout.astro';
import CategoryNav from '../components/CategoryNav.astro';
import VideoCard from '../components/VideoCard.astro';
import ContactForm from '../components/ContactForm.astro';
import translations from '../data/translations.json';
import worksData from '../data/works.json';

const t = translations.en;
---

<Layout lang="en">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <section class="text-center mb-12">
      <h1 class="text-5xl font-bold mb-4">{t.home.welcome}</h1>
      <p class="text-xl text-gray-600">{t.home.intro}</p>
    </section>

    <section id="about" class="mb-16 bg-white rounded-2xl p-8 shadow-sm">
      <h2 class="text-2xl font-bold mb-4">{t.about.title}</h2>
      <p class="text-gray-700 mb-4 leading-relaxed">{t.about.description}</p>
      <p class="text-gray-600 mb-6">{t.about.skills}</p>
      <a href={`${import.meta.env.BASE_URL}Resume_tjq.pdf`} download class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-full hover:bg-gray-800 transition-colors shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        {t.about.downloadCV}
      </a>
    </section>

    <section id="portfolio">
      <h2 class="text-3xl font-bold mb-6">{t.home.featured}</h2>

      <CategoryNav lang="en" />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {worksData.works.map(work => (
          <div class:list={['work-card', work.ratio === '16:9' ? 'md:col-span-2' : '']} data-category={work.category}>
            <VideoCard
              title={t.works[work.titleKey]}
              ratio={work.ratio}
              workId={work.id}
              category={work.category}
              src={work.src}
              poster={work.poster}
              prompt={work.promptKey ? t.prompts[work.promptKey] : undefined}
              description={work.descriptionKey ? t.works[work.descriptionKey] : undefined}
              externalLink={work.externalLink}
              lang="en"
            />
          </div>
        ))}
      </div>
    </section>

    <div class="mt-16">
      <ContactForm lang="en" />
    </div>
  </div>
</Layout>
