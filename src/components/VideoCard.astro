---
import translations from '../data/translations.json';

interface Props {
  title: string;
  ratio?: '9:16' | '16:9';
  src?: string;
  poster?: string;
  link?: string;
  workId?: string;
  prompt?: string;
  description?: string;
  category?: string;
  lang?: 'zh' | 'en';
  externalLink?: string;
}

const { title, ratio = '16:9', src, poster, link, workId, prompt, description, category, lang = 'zh', externalLink } = Astro.props;
const t = lang === 'zh' ? translations.zh : translations.en;
const aspectClass = ratio === '9:16' ? 'aspect-[9/16]' : 'aspect-[16/9]';
const detailLink = externalLink || (workId ? `/work/${workId}?lang=${lang}` : link);
const isExternal = !!externalLink;

// 默认图片路径：AIGC 作品从 /images/aigc/ 读取，其他从 /images/works/ 读取
const defaultSrc = workId ? (category === 'aigc' ? `/images/aigc/${workId}` : `/images/works/${workId}`) : undefined;
const finalSrc = src || poster || defaultSrc;

// 检测文件类型：根据扩展名判断是图片还是视频
const isVideo = src && /\.(mp4|webm|mov)$/i.test(src);
const isImage = finalSrc && /\.(png|jpg|jpeg|gif|webp)$/i.test(finalSrc);
---

<div class="work-card block bg-white rounded-2xl shadow-sm overflow-hidden hover:shadow-md transition-all duration-300 group" data-category={category || 'video-editing'}>
  <a href={detailLink || '#'} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined} class="block">
    <div class={`${aspectClass} bg-gray-100 relative overflow-hidden`}>
      {isVideo && (
        <video
          src={finalSrc}
          poster={poster}
          class="w-full h-full object-cover pointer-events-none group-hover:scale-105 transition-transform duration-300"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
      )}
      {isImage && (
        <img
          src={finalSrc}
          alt={title}
          class="w-full h-full object-cover pointer-events-none group-hover:scale-105 transition-transform duration-300"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
      )}
      {!finalSrc && (
        <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
          <span class="text-gray-400 text-4xl">🎬</span>
        </div>
      )}
      <div class="absolute inset-0 hidden items-center justify-center bg-red-50 border-4 border-red-500" style="display:none;">
        <div class="text-center p-4">
          <span class="text-red-600 text-2xl block mb-2">❌</span>
          <span class="text-red-600 text-sm">加载失败<br/>{finalSrc}</span>
        </div>
      </div>
      {category === 'aigc' && (
        <div class="absolute top-3 right-3 bg-purple-600 text-white text-xs px-2 py-1 rounded-full">
          ✨ AIGC
        </div>
      )}
    </div>
  </a>
  <div class="p-4">
    <h3 class="font-medium mb-2">{title}</h3>
    {description && (
      <p class="text-sm text-gray-600 mb-3 leading-relaxed">{description}</p>
    )}
    {prompt && (
      <button
        onclick={`alert('Prompt:\\n\\n${prompt.replace(/'/g, "\\'")}')` }
        class="text-xs text-purple-600 hover:text-purple-800 flex items-center gap-1 transition-colors"
      >
        <span>💬</span>
        <span>{t.works.promptView}</span>
      </button>
    )}
  </div>
</div>
