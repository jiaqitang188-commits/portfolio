---
import translations from '../data/translations.json';

interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const formspreeId = 'maqlwgoj'; // 替换为你的 Formspree ID
const t = lang === 'zh' ? translations.zh : translations.en;
---

<section id="contact" class="bg-white rounded-2xl p-8 shadow-sm">
  <h2 class="text-2xl font-bold mb-6">{t.contact.title}</h2>

  <form action={`https://formspree.io/f/${formspreeId}`} method="POST" class="space-y-4" id="contact-form">
    <div>
      <label class="block text-sm font-medium mb-2">{t.contact.name}</label>
      <input type="text" name="name" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:border-gray-400 focus:outline-none transition" />
    </div>

    <div>
      <label class="block text-sm font-medium mb-2">{t.contact.email}</label>
      <input type="email" name="email" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:border-gray-400 focus:outline-none transition" />
    </div>

    <div>
      <label class="block text-sm font-medium mb-2">{t.contact.purpose}</label>
      <select name="purpose" required class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:border-gray-400 focus:outline-none transition bg-white">
        <option value={t.contact.purposeJob}>{t.contact.purposeJob}</option>
        <option value={t.contact.purposeVideo}>{t.contact.purposeVideo}</option>
        <option value={t.contact.purposeOther}>{t.contact.purposeOther}</option>
      </select>
    </div>

    <div>
      <label class="block text-sm font-medium mb-2">{t.contact.message}</label>
      <textarea name="message" required rows="4" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:border-gray-400 focus:outline-none transition resize-none"></textarea>
    </div>

    <button type="submit" class="w-full bg-gray-900 text-white py-3 rounded-lg hover:bg-gray-800 transition">
      {t.contact.submit}
    </button>

    <div id="success-message" class="hidden bg-green-50 text-green-700 p-4 rounded-lg">
      {t.contact.success}
    </div>
  </form>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        form.reset();
        successMsg?.classList.remove('hidden');
        setTimeout(() => successMsg?.classList.add('hidden'), 5000);
      }
    } catch (error) {
      console.error('Form submission error:', error);
    }
  });
</script>
