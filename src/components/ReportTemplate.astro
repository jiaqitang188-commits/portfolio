---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
---

<article class="bg-white rounded-2xl shadow-sm p-8 max-w-4xl mx-auto my-8">
  <div class="mb-6">
    <span class="text-sm text-purple-600 font-medium">
      {lang === 'zh' ? '📰 深度报道' : '📰 In-depth Report'}
    </span>
    <h2 class="text-3xl font-bold mt-2 mb-4">
      {lang === 'zh' ? '报道标题' : 'Report Title'}
    </h2>
    <div class="flex gap-4 text-sm text-gray-500">
      <span>{lang === 'zh' ? '作者：姓名' : 'By: Name'}</span>
      <span>|</span>
      <span>{lang === 'zh' ? '日期：2026-03-25' : 'Date: 2026-03-25'}</span>
    </div>
  </div>

  <div class="prose prose-lg max-w-none">
    <p class="text-gray-700 leading-relaxed mb-4">
      {lang === 'zh'
        ? '这里是报道的引言部分，简要概述核心内容和关键发现...'
        : 'This is the lead paragraph, briefly summarizing the core content and key findings...'}
    </p>

    <h3 class="text-xl font-bold mt-6 mb-3">
      {lang === 'zh' ? '核心发现' : 'Key Findings'}
    </h3>
    <p class="text-gray-700 leading-relaxed mb-4">
      {lang === 'zh'
        ? '详细阐述调查过程、数据分析和关键洞察...'
        : 'Detailed investigation process, data analysis, and key insights...'}
    </p>

    <div class="bg-gray-50 rounded-lg p-6 my-6 border-l-4 border-purple-600">
      <p class="text-gray-800 italic">
        {lang === 'zh'
          ? '"引用关键人物的重要观点或数据支撑"'
          : '"Quote from key sources or data support"'}
      </p>
    </div>

    <h3 class="text-xl font-bold mt-6 mb-3">
      {lang === 'zh' ? '深度分析' : 'Deep Analysis'}
    </h3>
    <p class="text-gray-700 leading-relaxed">
      {lang === 'zh'
        ? '结合专业背景进行深入分析，提供独特视角...'
        : 'In-depth analysis with professional background, providing unique perspectives...'}
    </p>
  </div>
</article>
